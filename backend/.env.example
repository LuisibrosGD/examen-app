# La app usa pooled y Alembic usa direct; conservar los parámetros de Neon.
DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASENA@HOST_POOLER/neondb?sslmode=require&channel_binding=require
DATABASE_URL_DIRECT=postgresql+psycopg://USUARIO:CONTRASENA@HOST_DIRECT/neondb?sslmode=require&channel_binding=require
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_MINUTES=1440
# En Render usar únicamente ["https://examen-app-lyart.vercel.app"].
CORS_ORIGINS=["http://localhost:5173"]
